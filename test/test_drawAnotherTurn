from testing_base import *

def bookMade():
    # Inputs: 1, jack
    # Output: Should go fishing
        # have the text "Lucky draw, you've made a book!"
        # show the book that was made
        # End turn
    game = Games()
    deck = game.deck
    turn_list = [Player("Joker"), Player("Morgana")]
    turn_list[0].isTurn = True

    # Adds 3 of one kind of card to Joker's hand
    deck.cards.sort(key = lambda card: card.value)
    for i in range(3):
        turn_list[0].hand.append(deck.getCard())
        turn_list[0].knownCards.append(True)

    savedCard = deck.getCard() # Saves the fourth of a kind
    turn_list[1].hand.append(deck.getCard()) # Adds any card to Morgana's hand
    turn_list[1].knownCards.append(deck.getCard())
    deck.getCard() # Gets to new card to Joker doesn't steal Morgana's card
    deck.getCard()
    deck.getCard()
    turn_list[0].hand.append(deck.getCard()) # Adds any card to Joker's
    turn_list[0].knownCards.append(deck.getCard())
    deck.cards = []
    deck.cards.append(savedCard)

    turn_list[0].takeTurn(turn_list, game)

