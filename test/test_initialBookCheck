from testing_base import *

def noBooks():
    # If a player does not have any books at the beginning, nothing should be printed and the players book value should remain empty
    while True:
        game = Games()
        players = [Player("Toad"), Player("Yoshi"), Player("Penguin"), Player("Cow")]
        deck = Deck()
        dealer = Dealer(deck)

        dealer.dealCards(5, players)

        playerHasBook = False
        for player in players:
            if player.bookHandling():
                playerHasBook = True
        if not playerHasBook:
            break

    game.initialBookCheck(players)

    for player in players:
        assert player.books == []
    print("If this is the first line printed, this test passes.")


def allBooks():
    # If all players have books, it should print out accordingly
    game = Games()
    players = [Player("Toad"), Player("Yoshi"), Player("Penguin"), Player("Cow")]
    deck = Deck()
    testHand = 1

    # Looks through a deck to find needed cards
    for player in players:
        for card in deck.cards:
            if card.value == testHand:
                player.hand.append(card)
                player.knownCards.append(True)
        testHand += 1

    game.initialBookCheck(players)

    for player in players:
        assert player.books != []
    print("\nAll players should have printed one book")

def someBooks():
    # If only some of the players have books, it should print out theirs while ignoring those who don't 
    game = Games()
    players = [Player("Toad"), Player("Yoshi"), Player("Penguin"), Player("Cow")]
    deck = Deck()
    testHand = 1

    # Looks through a deck to find needed cards
    for player in players:
        if player.name not in ["Toad", "Penguin"]:
            continue
        for card in deck.cards:
            if card.value == testHand:
                player.hand.append(card)
                player.knownCards.append(True)
        testHand += 1

    game.initialBookCheck(players)

    for player in players:
        if player.name in ["Toad", "Penguin"]:
            assert player.books != []
        else:
            assert player.books == []

    print("\nToad and Penguin should have their books printed out.")

if __name__ == "__main__":
    noBooks()
    allBooks()
    someBooks()